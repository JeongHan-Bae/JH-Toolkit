# Normalize text in the repository and check it out with LF line endings.
* text=auto eol=lf

# Repository-owned support files are excluded from language statistics.
.github/** -linguist-detectable
docs/** -linguist-detectable

# Generated metadata.
dependencies.toml linguist-generated
assets/metadata/version_badge.json linguist-generated
assets/metadata/simple_cucumber_version_badge.json linguist-generated
assets/metadata/tiny_test_version_badge.json linguist-generated

# Force public implementation headers to be treated as C++.
include/jh/**/*.h linguist-language=C++

# Aggregate headers under include/jh/ have no extension.
include/jh/* linguist-language=C++
include/jh/*.* -linguist-language

# Force examples and tests to be treated as C++.
examples/**/*.h linguist-language=C++
tests/**/*.h linguist-language=C++
