/**
 * @file ipc
 * @brief Forward-aggregator header for <code>jh::ipc</code>.
 *
 * <p>
 * This header provides a flattened entry point to <code>jh::sync::ipc</code>
 * under the simplified namespace <code>jh::ipc</code>.
 * In JH Toolkit, IPC stands for <b>InterProcess Coordination</b>.
 * </p>
 *
 * <pre><code>#include &lt;jh/ipc&gt;</code></pre>
 *
 * <p>
 * Internally, it includes the synchronous IPC implementation from
 * <code>jh/synchronous/ipc.h</code> and re-exports it under
 * <code>jh::ipc</code>.
 * </p>
 *
 * <h4>Overview</h4>
 * <ul>
 *   <li>Defines <code>jh::ipc</code> as the user-facing namespace.</li>
 *   <li>Flattens the <code>jh::sync::ipc</code> hierarchy.</li>
 *   <li>Re-exports all IPC components:
 *     <code>limits</code>, <code>process_mutex</code>, <code>process_cond_var</code>,
 *     <code>process_counter</code>, <code>process_shm_obj</code>,
 *     <code>shared_process_mutex</code>, and <code>process_launcher</code>.</li>
 *   <li>All semantics remain authoritative in <code>jh/synchronous/ipc.h</code>.</li>
 * </ul>
 *
 * <img src="https://raw.githubusercontent.com/JeongHan-Bae/JH-Toolkit/main/docs/img/Ojing.svg" alt="Ojing mascot" width="64">
 *
 * <h4>Design Note</h4>
 * <p>
 * <code>jh::ipc</code> keeps process-level syntax close to in-process STL usage:
 *   <tt>named at compile time</tt>,
 *   <tt>globally addressable</tt>,
 *   and free of <tt>runtime registries</tt> or parent-process dependency.
 * Most process-level primitives are accessed via <code>::instance()</code>, with type identity
 * declared by NTTP strings. Different executables synchronize by instantiating the same names.
 * Shared objects are intentionally pure POD data; each process interprets that data locally.
 * </p>
 */

#pragma once

#include "jh/synchronous/ipc.h"

/**
 * @brief Convenience alias for <code>jh::sync::ipc</code>.
 *
 * The <code>jh::ipc</code> namespace is a flattened, user-facing alias
 * that re-exports all symbols from <code>jh::sync::ipc</code> directly
 * under <code>jh::ipc</code>.
 * <br>
 * This namespace introduces no new semantics and exists solely to
 * reduce include depth and namespace verbosity.
 *
 * @see <code>jh::sync::ipc</code>
 */
namespace jh::ipc {
    using namespace jh::sync::ipc;
}
