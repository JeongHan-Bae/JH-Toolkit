@PACKAGE_INIT@

set(_jh_toolkit_include_directory "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_INCLUDEDIR@")
set(JH_TOOLKIT_INSTALLED_FILES "")
set(_jh_toolkit_file_manifest "${CMAKE_CURRENT_LIST_DIR}/jh-toolkit-installed-files.cmake")
if (EXISTS "${_jh_toolkit_file_manifest}")
    include("${_jh_toolkit_file_manifest}")
endif ()

set(_jh_toolkit_actual_files "")
foreach (_jh_toolkit_file IN LISTS JH_TOOLKIT_INSTALLED_FILES)
    if (EXISTS "${PACKAGE_PREFIX_DIR}/${_jh_toolkit_file}")
        list(APPEND _jh_toolkit_actual_files "${_jh_toolkit_file}")
    endif ()
endforeach ()
set(JH_TOOLKIT_INSTALLED_FILES "${_jh_toolkit_actual_files}")
set(JH_TOOLKIT_NO_THROW_HEADERS "@JH_TOOLKIT_NO_THROW_HEADERS@")
set(JH_TOOLKIT_TEST_HEADERS "@JH_TOOLKIT_TEST_HEADERS@")
set(JH_TOOLKIT_IPC_HEADERS "@JH_TOOLKIT_IPC_HEADERS@")
set(JH_TOOLKIT_BASE_HEADERS "@JH_TOOLKIT_BASE_HEADERS@")
set(JH_TOOLKIT_ALL_HEADERS "@JH_TOOLKIT_ALL_HEADERS@")

function(_jh_toolkit_component_is_available output)
    set(_jh_available TRUE)
    foreach (_jh_header IN LISTS ARGN)
        set(_jh_file "@CMAKE_INSTALL_INCLUDEDIR@/${_jh_header}")
        if (NOT EXISTS "${_jh_toolkit_include_directory}/${_jh_header}")
            set(_jh_available FALSE)
            break()
        endif ()
    endforeach ()
    set(${output} "${_jh_available}" PARENT_SCOPE)
endfunction()

set(JH_TOOLKIT_AVAILABLE_COMPONENTS "")
_jh_toolkit_component_is_available(_jh_has_base ${JH_TOOLKIT_BASE_HEADERS})
_jh_toolkit_component_is_available(_jh_has_no_throw ${JH_TOOLKIT_NO_THROW_HEADERS})
_jh_toolkit_component_is_available(_jh_has_test_enabled ${JH_TOOLKIT_TEST_HEADERS})
_jh_toolkit_component_is_available(_jh_has_ipcs ${JH_TOOLKIT_IPC_HEADERS})
_jh_toolkit_component_is_available(_jh_has_all ${JH_TOOLKIT_ALL_HEADERS})

foreach (_jh_component IN ITEMS base jh-no-throw jh-test-enabled jh-ipcs all)
    set("jh-toolkit_${_jh_component}_FOUND" FALSE)
endforeach ()
if (_jh_has_base)
    list(APPEND JH_TOOLKIT_AVAILABLE_COMPONENTS base jh-no-throw jh-test-enabled)
    set(jh-toolkit_base_FOUND TRUE)
    set(jh-toolkit_jh-no-throw_FOUND TRUE)
    set(jh-toolkit_jh-test-enabled_FOUND TRUE)
endif ()
if (_jh_has_no_throw)
    list(APPEND JH_TOOLKIT_AVAILABLE_COMPONENTS jh-no-throw jh-test-enabled)
    set(jh-toolkit_jh-no-throw_FOUND TRUE)
    set(jh-toolkit_jh-test-enabled_FOUND TRUE)
endif ()
if (_jh_has_test_enabled)
    list(APPEND JH_TOOLKIT_AVAILABLE_COMPONENTS jh-test-enabled)
    set(jh-toolkit_jh-test-enabled_FOUND TRUE)
endif ()
if (_jh_has_ipcs)
    list(APPEND JH_TOOLKIT_AVAILABLE_COMPONENTS jh-ipcs jh-test-enabled)
    set(jh-toolkit_jh-ipcs_FOUND TRUE)
    set(jh-toolkit_jh-test-enabled_FOUND TRUE)
endif ()
if (_jh_has_all)
    list(APPEND JH_TOOLKIT_AVAILABLE_COMPONENTS all)
    set(jh-toolkit_all_FOUND TRUE)
endif ()
list(REMOVE_DUPLICATES JH_TOOLKIT_AVAILABLE_COMPONENTS)

include("${CMAKE_CURRENT_LIST_DIR}/jh-toolkitTargets.cmake")
if (EXISTS "${CMAKE_CURRENT_LIST_DIR}/jh-toolkit-staticTargets.cmake")
    include("${CMAKE_CURRENT_LIST_DIR}/jh-toolkit-staticTargets.cmake")
endif ()

define_property(TARGET PROPERTY JH_TOOLKIT_AVAILABLE_COMPONENTS
    BRIEF_DOCS "Components available in the installed JH-Toolkit headers"
    FULL_DOCS "Components derived from the actual installed JH-Toolkit header files")
set_property(TARGET jh::jh-toolkit PROPERTY
    JH_TOOLKIT_AVAILABLE_COMPONENTS "${JH_TOOLKIT_AVAILABLE_COMPONENTS}")
set_property(TARGET jh::jh-toolkit PROPERTY
    JH_TOOLKIT_INSTALLED_FILES "${JH_TOOLKIT_INSTALLED_FILES}")
if (_jh_has_ipcs)
    set_property(TARGET jh::jh-toolkit APPEND PROPERTY
        INTERFACE_COMPILE_DEFINITIONS JH_TOOLKIT_ENABLE_IPCS=1)
endif ()

check_required_components(jh-toolkit)
